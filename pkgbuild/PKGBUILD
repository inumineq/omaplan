pkgname=omaplan
pkgver=0.2.0
pkgrel=1
pkgdesc='Plan your tasks with AI: write them in plain text and see the plan as overview, calendar, list or timeline'
arch=('x86_64' 'aarch64')
url='https://github.com/inumineq/omaplan'
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'hicolor-icon-theme')
makedepends=('gcc' 'make' 'qt6-tools')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/omaplan "$pkgdir/usr/bin/omaplan"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/omaplan.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/omaplan.svg"
  install -Dm644 "$startdir/omaplan.desktop" "$pkgdir/usr/share/applications/omaplan.desktop"
}
