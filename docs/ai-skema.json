{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Omaplan-forslag",
  "type": "object",
  "required": ["opgaver"],
  "additionalProperties": false,
  "properties": {
    "opgaver": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["titel"],
        "additionalProperties": false,
        "properties": {
          "titel": {"type": "string", "minLength": 1, "maxLength": 200},
          "noter": {"type": "string"},
          "projekt": {"type": "string"},
          "prioritet": {"type": "integer", "minimum": 1, "maximum": 3},
          "start": {"type": "string", "description": "ISO 8601 dato (YYYY-MM-DD) eller dato+tid (YYYY-MM-DDTHH:MM), lokal tid"},
          "varighed_min": {"type": "integer", "minimum": 1},
          "frist": {"type": "string", "description": "ISO 8601 dato eller dato+tid, lokal tid"},
          "gaet": {"type": "array", "items": {"enum": ["start", "varighed_min", "frist", "projekt", "prioritet"]}}
        }
      }
    },
    "uafklaret": {"type": "array", "items": {"type": "string"}, "description": "tekststykker motoren ikke kunne gøre til opgaver"}
  }
}
