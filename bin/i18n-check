#!/bin/sh
# Fails when a qsTr/tr string in src/ has no translation in a committed
# i18n/omaplan_<lang>.ts (English: no plural forms), or when a .ts file is out
# of date with the sources. Runs lupdate on temporary copies; never changes
# the repository. Run by bin/test; fix with bin/i18n-update and translate.
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
LUPDATE="$(command -v lupdate6 || command -v lupdate-qt6 || true)"
[ -n "$LUPDATE" ] || LUPDATE="$(qmake6 -query QT_HOST_BINS)/lupdate"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

cd "$ROOT"
status=0
for ts in i18n/omaplan_*.ts; do
    lang="$(basename "$ts" .ts | sed 's/^omaplan_//')"
    cp "$ts" "$TMP/$lang.ts"
    plural=""
    [ "$lang" = en ] && plural="-pluralonly"
    "$LUPDATE" -silent -extensions cpp,h,qml -locations none -no-obsolete $plural \
        -source-language en -target-language "$lang" src -ts "$TMP/$lang.ts" 2>/dev/null
    missing="$(grep -c 'type="unfinished"' "$TMP/$lang.ts" || true)"
    if [ "$missing" -ne 0 ]; then
        echo "i18n: $ts lacks $missing translation(s):" >&2
        grep -B4 'type="unfinished"' "$TMP/$lang.ts" | sed -n 's#.*<source>\(.*\)</source>.*#  \1#p' >&2
        status=1
    elif ! cmp -s "$ts" "$TMP/$lang.ts"; then
        echo "i18n: $ts is out of date with the sources; run bin/i18n-update" >&2
        status=1
    fi
done
[ "$status" -eq 0 ] && echo "i18n: every string is translated"
exit "$status"
