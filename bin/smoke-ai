#!/bin/sh
# Manual smoke test of the real AI engines: sends one short Danish text to an
# engine and prints the raw answer plus the elapsed time. NOT run by bin/test,
# and never run by the test suite -- a human runs it when they have an engine
# configured (vibe/claude login, or a local server in config.toml).
#
# Usage: bin/smoke-ai [engine]       # engine: vibe | claude | local (default: config default)
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
BIN="$ROOT/build/omaplan"

[ -x "$BIN" ] || "$ROOT/bin/build"

ENGINE="${1:-}"
# User input may be in any language; Danish exercises the date annotation.
TEXT="køb mælk i morgen og skriv et blogindlæg fredag kl. 14:30, 30 min, projekt Blog"

if [ -n "$ENGINE" ]; then
    set -- "$BIN" add "$TEXT" --engine "$ENGINE" --json
else
    set -- "$BIN" add "$TEXT" --json
fi

START=$(date +%s)
if "$@"; then
    echo "OK in $(( $(date +%s) - START )) s"
else
    echo "FAILED after $(( $(date +%s) - START )) s (exit $?)"
    exit 1
fi
