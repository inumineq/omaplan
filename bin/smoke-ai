#!/bin/sh
# Manual smoke test of the real AI engines: sends one short Danish text to a
# motor and prints the raw answer plus the elapsed time. NOT run by bin/test,
# and never run by the test suite -- a human runs it when they have a motor
# configured (vibe/claude login, or a local server in config.toml).
#
# Usage: bin/smoke-ai [motor]        # motor: vibe | claude | lokal (default: config default)
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
BIN="$ROOT/build/omaplan"

[ -x "$BIN" ] || "$ROOT/bin/build"

MOTOR="${1:-}"
TEXT="køb mælk i morgen og skriv et blogindlæg fredag kl. 14:30, 30 min, projekt Blog"

if [ -n "$MOTOR" ]; then
    set -- "$BIN" add "$TEXT" --motor "$MOTOR" --json
else
    set -- "$BIN" add "$TEXT" --json
fi

START=$(date +%s)
if "$@"; then
    echo "OK in $(( $(date +%s) - START )) s"
else
    echo "FAILED after $(( $(date +%s) - START )) s (exit $?)"
    exit 1
fi
