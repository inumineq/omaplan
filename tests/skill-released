#!/bin/sh
# A changed skill must list main's text as released (src/skill.cpp,
# wasBundled), or upgrading users get "Customized skill preserved". Outside a
# checkout with a main branch (a release tarball) there is nothing to compare.
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
[ "$(git -C "$ROOT" rev-parse --show-toplevel 2>/dev/null)" = "$ROOT" ] || exit 0
git -C "$ROOT" rev-parse -q --verify main >/dev/null 2>&1 || exit 0

released="$(git -C "$ROOT" show main:src/skill/SKILL.md | sha256sum | cut -d' ' -f1)"
current="$(sha256sum "$ROOT/src/skill/SKILL.md" | cut -d' ' -f1)"
if [ "$released" != "$current" ] && ! grep -q "$released" "$ROOT/src/skill.cpp"; then
    echo "skill: add $released (main's SKILL.md) to wasBundled in src/skill.cpp" >&2
    exit 1
fi
